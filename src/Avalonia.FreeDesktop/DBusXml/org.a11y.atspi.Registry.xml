<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.a11y.atspi.Registry">
    <method name="RegisterApplication">
      <arg direction="in" name="app" type="(so)"/>
    </method>
    <method name="DeregisterApplication">
      <arg direction="in" name="app" type="(so)"/>
    </method>
    <method name="GetApplications">
      <arg direction="out" type="a(so)"/>
    </method>
    <method name="RegisterEventListener">
      <arg direction="in" name="listener" type="s"/>
      <arg direction="in" name="eventName" type="s"/>
    </method>
    <method name="DeregisterEventListener">
      <arg direction="in" name="listener" type="s"/>
      <arg direction="in" name="eventName" type="s"/>
    </method>
  </interface>
</node>