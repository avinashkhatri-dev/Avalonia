<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LinuxAtSpiTest.MainWindow"
        Title="AT-SPI Test Application"
        Width="600" Height="500">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="10">
            
            <!-- Header -->
            <TextBlock Text="AT-SPI Test Application" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"
                       Name="HeaderTextBlock" />
            
            <TextBlock Text="This application tests various controls with AT-SPI accessibility on Linux" 
                       HorizontalAlignment="Center" 
                       TextWrapping="Wrap"
                       Margin="0,0,0,20" />

            <!-- Buttons Section -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Buttons" FontWeight="Bold" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Click Me" Click="OnButtonClick" Name="ClickButton" />
                        <Button Content="Save" Click="OnButtonClick" Name="SaveButton" />
                        <Button Content="Cancel" Click="OnButtonClick" Name="CancelButton" IsEnabled="False" />
                        <Button Content="Delete" Click="OnButtonClick" Name="DeleteButton" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Text Input Section -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Text Input" FontWeight="Bold" Margin="0,0,0,10" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBox Name="NameTextBox" Grid.Row="0" Grid.Column="1" 
                                 Watermark="Enter your name" 
                                 TextChanged="OnTextChanged" />
                        
                        <TextBlock Text="Email:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,0,0" />
                        <TextBox Name="EmailTextBox" Grid.Row="1" Grid.Column="1" 
                                 Watermark="Enter email address" 
                                 Margin="0,5,0,0"
                                 TextChanged="OnTextChanged" />
                        
                        <TextBlock Text="Description:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,5,0,0" />
                        <TextBox Name="DescriptionTextBox" Grid.Row="2" Grid.Column="1" 
                                 AcceptsReturn="True" 
                                 Height="80" 
                                 TextWrapping="Wrap"
                                 Watermark="Enter description..."
                                 Margin="0,5,0,0"
                                 TextChanged="OnTextChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Selection Controls -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Selection Controls" FontWeight="Bold" Margin="0,0,0,10" />
                    
                    <!-- CheckBoxes -->
                    <TextBlock Text="Preferences:" Margin="0,5" />
                    <StackPanel Orientation="Horizontal" Spacing="15">
                        <CheckBox Content="Enable notifications" Name="NotificationsCheckBox" IsChecked="True" Checked="OnCheckBoxChanged" Unchecked="OnCheckBoxChanged" />
                        <CheckBox Content="Auto-save" Name="AutoSaveCheckBox" Checked="OnCheckBoxChanged" Unchecked="OnCheckBoxChanged" />
                        <CheckBox Content="Dark mode" Name="DarkModeCheckBox" Checked="OnCheckBoxChanged" Unchecked="OnCheckBoxChanged" />
                    </StackPanel>
                    
                    <!-- RadioButtons -->
                    <TextBlock Text="Priority:" Margin="0,10,0,5" />
                    <StackPanel Orientation="Horizontal" Spacing="15">
                        <RadioButton Content="Low" GroupName="Priority" Name="LowPriorityRadio" />
                        <RadioButton Content="Medium" GroupName="Priority" Name="MediumPriorityRadio" IsChecked="True" />
                        <RadioButton Content="High" GroupName="Priority" Name="HighPriorityRadio" />
                    </StackPanel>
                    
                    <!-- ComboBox -->
                    <TextBlock Text="Category:" Margin="0,10,0,5" />
                    <ComboBox Name="CategoryComboBox" Width="200" HorizontalAlignment="Left" SelectionChanged="OnComboBoxSelectionChanged">
                        <ComboBoxItem Content="General" />
                        <ComboBoxItem Content="Work" IsSelected="True" />
                        <ComboBoxItem Content="Personal" />
                        <ComboBoxItem Content="Education" />
                        <ComboBoxItem Content="Health" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Numeric Controls -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Numeric Controls" FontWeight="Bold" Margin="0,0,0,10" />
                    
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="Volume:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                        <Slider Name="VolumeSlider" Grid.Row="0" Grid.Column="1" 
                                Minimum="0" Maximum="100" Value="50" 
                                ValueChanged="OnSliderValueChanged"
                                Margin="10,0" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="50%" Name="VolumeLabel" VerticalAlignment="Center" />
                        
                        <TextBlock Text="Quantity:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,10,0,0" />
                        <NumericUpDown Name="QuantityNumeric" Grid.Row="1" Grid.Column="1" 
                                       Minimum="1" Maximum="999" Value="1" 
                                       Margin="10,10,10,0" HorizontalAlignment="Left" Width="120" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Progress and Status -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Progress and Status" FontWeight="Bold" Margin="0,0,0,10" />
                    
                    <TextBlock Text="Download Progress:" Margin="0,5" />
                    <ProgressBar Name="DownloadProgress" Value="65" Maximum="100" Height="20" />
                    <TextBlock Text="65% Complete" HorizontalAlignment="Center" Margin="0,5" />
                    
                    <TextBlock Text="Processing..." Margin="0,10,0,5" />
                    <ProgressBar Name="ProcessingProgress" IsIndeterminate="True" Height="20" />
                </StackPanel>
            </Border>

            <!-- Status Display -->
            <Border BorderBrush="Blue" BorderThickness="2" Padding="10" CornerRadius="5" Background="LightBlue">
                <StackPanel>
                    <TextBlock Text="Status:" FontWeight="Bold" />
                    <TextBlock Name="StatusTextBlock" 
                               Text="Application started. Interact with controls to see status updates."
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <!-- Instructions -->
            <Border BorderBrush="Green" BorderThickness="1" Padding="10" CornerRadius="5" Background="LightGreen">
                <StackPanel>
                    <TextBlock Text="Testing Instructions:" FontWeight="Bold" />
                    <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                        <Run Text="1. Build and run this application on Linux" />
                        <LineBreak />
                        <Run Text="2. Install at-spi2-core package if not available" />
                        <LineBreak />
                        <Run Text="3. Run 'atspi-spy' or 'accerciser' to inspect the accessibility tree" />
                        <LineBreak />
                        <Run Text="4. Navigate through the application's controls in the AT-SPI inspector" />
                        <LineBreak />
                        <Run Text="5. Test clicking on buttons and changing values through AT-SPI" />
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>